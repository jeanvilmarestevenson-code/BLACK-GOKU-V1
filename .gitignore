cat > .gitignore << 'EOF'
# DEPENDENCIES
node_modules/
package-lock.json
yarn.lock
npm-debug.log
yarn-debug.log
yarn-error.log

# BAILEYS SESSION - TRES IMPORTANT
auth2/
auth/
auth_info/
auth_info_baileys/
session/
creds.json
qrcode.png

# ENV
.env
.env.local
.env.development
.env.production
.env.*.local

# DB
black_db.json
black_db.json.bak
database.json
*.db
*.sqlite

# LOGS
logs/
*.log
logs
pids/
*.pid
*.seed
*.pid.lock
npm-debug.log*
pm2 logs

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
Desktop.ini
$RECYCLE.BIN/

# RENDER / BUILD
.render/
.vercel/
dist/
build/
.next/
out/

# TEMP
tmp/
temp/
.tmp/
*.tmp
*.temp
.cache/

# LOURD - mais GARDE TES IMAGES BOT
*.mp4
*.mov
*.avi
*.zip
*.rar
*.tar
*.gz
EOF

git add .gitignore
git add "menu.jpg" "goku.jpg" "waifu 1.jpg" "waifu1.jpg" "waifu.jpg" 2>/dev/null || true
git commit -m "fix gitignore - keep menu.jpg goku.jpg waifu"
git push
